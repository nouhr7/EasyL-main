# Copy this file to .env and fill in real values. .env is gitignored.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Leave DB_ENGINE unset (or anything other than postgresql) to use SQLite.
# Set DB_ENGINE=postgresql to use PostgreSQL with the values below.
DB_ENGINE=postgresql
DB_NAME=easyline
DB_USER=easyline
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
